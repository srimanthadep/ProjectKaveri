DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kaveri
SECRET_KEY=change_this_to_a_secure_random_string_of_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
# Comma-separated list of allowed browser origins for CORS. Required because
# the API sends credentials; browsers reject "*" combined with credentials.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
