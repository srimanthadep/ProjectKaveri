# Render Production Environment Variables
# Render Web Service Settings -> Environment

# 1. Cryptographic Secret Key (min 32 random characters)
SECRET_KEY=change-this-to-a-very-long-random-string-in-production-min-32-chars

# 2. Database URL (Automatically supplied if using Render PostgreSQL)
# Format: postgresql+psycopg2://user:password@host:port/database
DATABASE_URL=postgresql+psycopg2://kaveri_user:secret_password@kaveri-db:5432/kaveri

# 3. Google Gemini API Key for AI Assistant copilot
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# 5. Token Lifespans
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
BCRYPT_ROUNDS=12

# 6. CORS Settings
CORS_ORIGINS=https://vercel.app,http://localhost:3000
CORS_ORIGIN_REGEX=https://.*\.vercel\.app|http://localhost:\d+|http://127\.0\.0\.1:\d+
