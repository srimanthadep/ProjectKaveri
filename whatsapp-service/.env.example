# Port this service listens on. Kept off 3000 (frontend) and 8000 (FastAPI).
PORT=4500

# Kaveri FastAPI backend base URL.
KAVERI_API_URL=http://localhost:8000

# Service-account credentials this process authenticates as against the
# Kaveri API (seeded by backend/init_db.py). Grants owner-level read access
# so any guest, at any property, can be resolved by phone number.
KAVERI_SERVICE_EMAIL=whatsapp.service@kaveristays.internal
KAVERI_SERVICE_PASSWORD=ConciergeService2026!Bot

# Shared secret the frontend/backend must present to call this service's
# HTTP endpoints (QR stream, send message, inbox reads). Generate a random
# 32+ character string for production.
WHATSAPP_SERVICE_TOKEN=change_this_to_a_random_32_char_secret

# Comma-separated browser origins allowed to hit this service directly
# (Socket.io + REST). The Vite dev server by default.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local SQLite database file for sessions, inbox, contacts, and the send queue.
DATABASE_PATH=./whatsapp.db

# Google Gemini API key for the concierge bot. Leave blank to disable the
# bot (inbox + manual sending still work without it).
GEMINI_API_KEY=

# Model id. gemini-1.5-flash is the current stable low-latency model; swap to
# whatever your key has access to.
GEMINI_MODEL=gemini-2.5-flash-lite

# Max AI bot replies a single WhatsApp number may trigger per hour, to bound
# API spend if a number gets spammed or loops.
BOT_RATE_LIMIT_PER_HOUR=20

# Directory received/sent media is written to and served from at /media/*.
# Swap for a Cloudinary (or S3) upload in uploadMediaToCloud() when available.
MEDIA_DIR=./media

# Local folder for the Baileys auth cache placeholder (kept for parity with
# the reference doc; actual credentials live in SQLite, never on disk here).
SESSION_LABEL=default-session
